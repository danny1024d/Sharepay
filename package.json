{
  "name": "travel-split-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "sync:access": "node ./scripts/sync-access.mjs",
    "predev": "npm run sync:access",
    "prebuild": "npm run sync:access",
    "vite": "npx --yes node@22 ./node_modules/vite/bin/vite.js",
    "dev": "npm run build:css && npm run vite -- --host 0.0.0.0 --port 5000 --strictPort",
    "build:css": "tailwindcss -i ./public/tailwind.input.css -o ./public/tailwind.generated.css --minify",
    "build": "npm run build:css && npm run vite -- build",
    "test:ledger": "node --test test/ledger-math.test.js",
    "test": "npm run test:ledger && npm --prefix worker test",
    "download:maps": "node ./scripts/download-ski-maps.mjs",
    "preview": "npm run vite -- preview --host 0.0.0.0 --port 4173 --strictPort",
    "deploy": "npm run build && firebase deploy --only hosting,firestore:rules"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.0",
    "lucide": "^1.56.0",
    "tailwindcss": "^4.3.3",
    "vite": "^6.4.4"
  },
  "dependencies": {
    "@zxing/browser": "^0.2.1"
  }
}
