rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAllowedUser() {
      return request.auth != null
        && request.auth.token.email in [
        // BEGIN GENERATED ALLOWED EMAILS
          'zzdanny781024@gmail.com',
          'ben155373@gmail.com',
          'jjkao1024@gmail.com'
        // END GENERATED ALLOWED EMAILS
        ];
    }

    match /ledgers/travel-split-app/{entryType}/{entryId} {
      allow read, write: if isAllowedUser();
    }

    match /ledgers/travel-split-app/trips/{tripId} {
      allow read, write: if isAllowedUser();

      match /{document=**} {
        allow read, write: if isAllowedUser();
      }
    }

    match /ledgers/travel-split-app/places/{placeId}/googleLocations/{locationId} {
      allow read, write: if isAllowedUser();
    }

    match /ledgers/travel-split-app/imageAnalyses/{analysisId}/assets/{assetId} {
      allow read, write: if isAllowedUser();
    }

  }
}